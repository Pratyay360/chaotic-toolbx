FROM quay.io/toolbx/arch-toolbox:latest

LABEL com.github.containers.toolbox="true" \
    name="arch-chaotic-aur-toolbox" \
    version="latest" \
    usage="This image is meant to be used with the toolbox or distrobox command" \
    summary="Arch Linux toolbox container with Chaotic AUR and paru" \
    maintainer="Pratyay Mustafi <pratyaymustafi@outlook.com>"

COPY scripts/ /scripts/
COPY packages/ /packages/
RUN sudo su
RUN chmod +x /scripts/chaotic.sh && /scripts/chaotic.sh
RUN rm -rf /scripts /packages
